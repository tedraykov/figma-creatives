# --- Sign-in for the web UI (any OpenID Connect provider: Clerk, Auth0, ...) ---
# Clerk: the instance's Frontend API URL. Auth0: https://<tenant>.<region>.auth0.com/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Optional second lock: comma-separated emails, or @yourcompany.com for a whole domain.
# Leave empty to let any verified user of your provider in (restrict sign-ups there).
ALLOWED_EMAILS=
# Public address of the app (otherwise taken from the request), e.g. https://creatives.tedraykov.me
PUBLIC_URL=

# --- Optional Figma defaults ---
# Integrations and projects are normally added in the app (Settings, Link project).
# If set, they appear as an "Environment" integration and project.
FIGMA_TOKEN=
FIGMA_FILE_KEY=

# --- Optional ---
# DATA_DIR=/app/data        # where creatives.db lives: mount a persistent volume here
CACHE_TTL_SECONDS=300       # how often to re-check Figma for design changes
MAX_CONCURRENCY=2           # parallel renders
GOOGLE_FONTS=true           # load fonts used by text layers from Google Fonts
MIN_FONT_SIZE=8             # smallest size auto-fit may shrink text to
RENDER_TIMEOUT_MS=30000
# AUTH_DISABLED=true        # local use ONLY: skips sign-in entirely
# API keys for n8n are created in the app (Settings > API keys), not here.
