# Figma personal access token (Settings > Security > Personal access tokens), scope: file_content:read
FIGMA_TOKEN=
# Default Figma file holding the templates (the part after /design/ in the file URL)
FIGMA_FILE_KEY=
# Shared secret n8n sends as "Authorization: Bearer <API_KEY>"
API_KEY=

# Optional
CACHE_TTL_SECONDS=300     # how often to re-check Figma for design changes
MAX_CONCURRENCY=2         # parallel renders
GOOGLE_FONTS=true         # load fonts used by text layers from Google Fonts
MIN_FONT_SIZE=8           # smallest size auto-fit may shrink text to
RENDER_TIMEOUT_MS=30000
