{
  "name": "Creatives: export campaign to Drive",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Export campaign to Drive",
        "formDescription": "Exports every frame on a campaign page (made by the Figma plugin) as a JPG and files it in Drive: year / month / date and campaign / format. In Figma, right-click the campaign page in the Pages list and choose Copy link.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Figma page URL",
              "placeholder": "https://www.figma.com/design/…?node-id=…",
              "requiredField": true
            },
            {
              "fieldLabel": "Drive root folder URL",
              "defaultValue": "https://drive.google.com/drive/folders/REPLACE_WITH_YOUR_ROOT_FOLDER",
              "requiredField": true
            },
            {
              "fieldLabel": "Scale",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "1x"
                  },
                  {
                    "option": "2x"
                  }
                ]
              },
              "defaultValue": "1x"
            }
          ]
        },
        "options": {}
      },
      "id": "b2f0c002-0000-4000-8000-000000000001",
      "name": "Export form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.2,
      "position": [
        1072,
        432
      ],
      "webhookId": "figma-renderer-export"
    },
    {
      "parameters": {
        "jsCode": "// Reads the page link and the Drive root from the form.\nconst form = $input.first().json;\nconst link = String(form['Figma page URL'] ?? '').trim();\nconst file = link.match(/figma\\.com\\/(?:design|file)\\/([A-Za-z0-9]+)/);\nif (!file) throw new Error('The Figma page URL is not a figma.com/design link.');\nlet node = '';\ntry { node = (new URL(link).searchParams.get('node-id') ?? '').replace('-', ':'); } catch { /* handled below */ }\nif (!node) throw new Error('The link has no node-id. In Figma, right-click the campaign page in the Pages list and choose Copy link.');\n\nconst root = String(form['Drive root folder URL'] ?? '').trim();\nconst rootId = root.match(/folders\\/([A-Za-z0-9_-]+)/)?.[1] ?? (/^[A-Za-z0-9_-]{15,}$/.test(root) ? root : null);\nif (!rootId || root.includes('REPLACE_WITH')) throw new Error('Set the Drive root folder URL (a drive.google.com/drive/folders/… link). You can change its default in the form trigger.');\n\nreturn [{ json: { fileKey: file[1], nodeId: node, rootId, scale: parseInt(form.Scale, 10) || 1 } }];\n"
      },
      "id": "b2f0c002-0000-4000-8000-000000000002",
      "name": "Parse form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        432
      ]
    },
    {
      "parameters": {
        "url": "=https://api.figma.com/v1/files/{{ $json.fileKey }}/nodes?ids={{ encodeURIComponent($json.nodeId) }}&depth=3",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b2f0c002-0000-4000-8000-000000000003",
      "name": "Get page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1552,
        432
      ]
    },
    {
      "parameters": {
        "jsCode": "// The page name is \"DD.MM.YYYY Campaign title\" (the plugin names it so). Frames are \"template/ratio/language\".\n// Hidden frames are skipped, so hide any you do not want exported.\nconst { fileKey, nodeId, rootId, scale } = $('Parse form').first().json;\nconst page = $input.first().json.nodes?.[nodeId]?.document;\nif (!page) throw new Error('Figma did not return that page. Check the link and that the token can read the file.');\nif (page.type !== 'CANVAS') throw new Error(`That link points to a ${page.type.toLowerCase()}, not a page. Right-click the campaign page in the Pages list and choose Copy link.`);\n\nconst head = page.name.match(/^(\\d{2})\\.(\\d{2})\\.(\\d{4})\\s+(.+)$/);\nif (!head) throw new Error(`The page is named \"${page.name}\". It must start with the campaign date, like \"12.10.2026 Autumn Sale\".`);\nconst [, dd, mm, yyyy, title] = head;\nconst MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\nif (Number(mm) < 1 || Number(mm) > 12) throw new Error(`\"${page.name}\" has no valid month.`);\n\nconst NAME = /^([^/]+)\\/([^/]+)\\/([^/]+)$/;\nconst frames = [];\nconst walk = (n) => {\n  for (const c of n.children ?? []) {\n    if (c.visible === false) continue;\n    if (c.type === 'SECTION') walk(c);\n    else if (c.type === 'FRAME') {\n      const m = c.name.match(NAME);\n      if (m) frames.push({ id: c.id, template: m[1].trim(), ratio: m[2].trim(), language: m[3].trim() });\n    }\n  }\n};\nwalk(page);\nif (!frames.length) throw new Error(`No frames named template/ratio/language on \"${page.name}\".`);\n\n// One template per campaign, so each format folder holds DDMM-LANG.jpg once per language.\nconst seen = new Map();\nfor (const f of frames) {\n  f.fileName = `${dd}${mm}-${f.language.toUpperCase()}.jpg`;\n  const slot = `${f.ratio}/${f.fileName}`;\n  if (seen.has(slot)) throw new Error(`\"${seen.get(slot)}\" and \"${f.template}/${f.ratio}/${f.language}\" would both become ${slot}. A campaign page should use one template; hide or rename one.`);\n  seen.set(slot, `${f.template}/${f.ratio}/${f.language}`);\n}\n\nreturn [{ json: {\n  fileKey, rootId, scale, frames,\n  year: yyyy, month: `${mm}. ${MONTHS[Number(mm) - 1]}`, campaign: `${dd}.${mm}.${yyyy} ${title.trim()}`,\n  ratios: [...new Set(frames.map((f) => f.ratio))],\n} }];\n"
      },
      "id": "b2f0c002-0000-4000-8000-000000000004",
      "name": "Plan export",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        432
      ]
    },
    {
      "parameters": {
        "jsCode": "// Figma renders many frames per request; keep each URL short.\nconst p = $input.first().json;\nconst ids = p.frames.map((f) => f.id);\nconst out = [];\nfor (let i = 0; i < ids.length; i += 30) out.push({ json: { fileKey: p.fileKey, scale: p.scale, ids: ids.slice(i, i + 30).join(',') } });\nreturn out;\n"
      },
      "id": "b2f0c002-0000-4000-8000-000000000005",
      "name": "Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2032,
        432
      ]
    },
    {
      "parameters": {
        "url": "=https://api.figma.com/v1/images/{{ $json.fileKey }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "ids",
              "value": "={{ $json.ids }}"
            },
            {
              "name": "format",
              "value": "jpg"
            },
            {
              "name": "scale",
              "value": "={{ $json.scale }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "b2f0c002-0000-4000-8000-000000000006",
      "name": "Render in Figma",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2272,
        432
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const plan = $('Plan export').first().json;\nconst urls = {};\nfor (const item of $input.all()) Object.assign(urls, item.json.images ?? {});\nconst missing = plan.frames.filter((f) => !urls[f.id]);\nif (missing.length) throw new Error(`Figma could not render: ${missing.map((f) => `${f.template}/${f.ratio}/${f.language}`).join(', ')}. Frames over about 32 megapixels fail at 2x; try 1x.`);\nreturn [{ json: { ...plan, frames: plan.frames.map((f) => ({ ...f, url: urls[f.id] })) } }];\n"
      },
      "id": "b2f0c002-0000-4000-8000-000000000007",
      "name": "Image URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2512,
        432
      ]
    },
    {
